# Copy to .env and fill in real values. Never commit .env.
# Database (Prisma sqlite). Example: file:./dev.db
DATABASE_URL="file:./dev.db"

# Admin session signing secret (required, min 32 random chars)
AUTH_SECRET="change-me-to-a-long-random-secret"

# Public site base URL used for metadata/sitemap fallbacks
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Initial admin provisioning (scripts/provision-admin.ts)
INITIAL_ADMIN_EMAIL="admin@bookingnetwork.com"
INITIAL_ADMIN_PASSWORD=""

# Seed script admin (prisma/seed.ts)
ADMIN_EMAIL="admin@bookingnetwork.com"
ADMIN_PASSWORD=""

# Inquiry notification fallback recipient
NOTIFICATION_EMAIL=""

# SMTP (optional; without it, inquiry emails are logged, not sent)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@bookingnetwork.com"
