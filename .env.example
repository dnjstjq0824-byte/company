# Database Configuration
# Local persistent SQLite database (or replace with PostgreSQL connection string in production)
DATABASE_URL="file:./dev.db"

# Security & Session Secret (Change in production using a 32+ byte random hex string)
AUTH_SECRET=""

# Admin Initial Provisioning (Used only by `npm run db:provision-admin` or initial seed)
# Never hardcode production credentials in source code
INITIAL_ADMIN_EMAIL="admin@bookingnetwork.example"
INITIAL_ADMIN_PASSWORD=""

# Corporate Website Base URL (Updated once official domain is verified)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional SMTP Configuration for Contact Inquiry Notifications
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@bookingnetwork.example"

