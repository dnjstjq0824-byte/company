# ==============================================================================
# Booking Network Global Group — Environment Configuration Template
# ==============================================================================
# Copy this file to .env or .env.local for local development.
# For Cloudflare Workers production, set secrets via:
#   npx wrangler secret put <VARIABLE_NAME>
# or configure them in Cloudflare Dashboard -> Workers & Pages -> company -> Settings -> Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration
# ------------------------------------------------------------------------------
# Local Development: SQLite file (e.g., "file:./dev.db")
# Production (Cloudflare Workers):
#   - Serverless PostgreSQL (Neon, Supabase): "postgresql://user:pass@host/db?sslmode=require"
#   - Turso (libSQL): "libsql://[database].turso.io?authToken=[token]"
#   - Cloudflare D1: Bound via wrangler.jsonc [[d1_databases]]
# Fail-closed note: In production Workers, leaving DATABASE_URL empty causes admin CRUD
# and contact inquiry endpoints to return 500 error instead of silently losing data.
DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------------------
# 2. Security & Administrator Authentication (MANDATORY IN PRODUCTION)
# ------------------------------------------------------------------------------
# Secret key used for signing and verifying administrator session JWTs (HS256).
# Generate a strong 32+ byte random hex string:
#   openssl rand -hex 32
# Fail-closed policy: If AUTH_SECRET is missing or empty, all admin authentication,
# session verification, and token signing are strictly rejected (HTTP 401/500).
AUTH_SECRET=""

# ------------------------------------------------------------------------------
# 3. Administrator Initial Provisioning (Local CLI / Setup Script Only)
# ------------------------------------------------------------------------------
# Used exclusively by `npm run db:provision-admin` or initial local seed script.
# NEVER commit production admin passwords or store plaintext credentials in git!
INITIAL_ADMIN_EMAIL="admin@bookingnetwork.example"
INITIAL_ADMIN_PASSWORD=""

# ------------------------------------------------------------------------------
# 4. Canonical Site URL & SEO Metadata
# ------------------------------------------------------------------------------
# The canonical base URL of the corporate portal.
# Production Worker URL: "https://company.dnjstjq0824.workers.dev"
# Custom Domain (when bound): "https://bookingnetwork.com"
NEXT_PUBLIC_SITE_URL="https://company.dnjstjq0824.workers.dev"

# ------------------------------------------------------------------------------
# 5. Outbound SMTP Configuration (Optional)
# ------------------------------------------------------------------------------
# Optional SMTP configuration for transmitting inquiry notifications to administrators.
# If omitted or incomplete, contact submissions are stored in the database without failing.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@bookingnetwork.example"
